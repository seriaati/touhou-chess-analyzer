<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameData>$(HOME)/.local/share/Steam/steamapps/common/Touhou Chess/TOUHOU CHESS_Data</GameData>
    <DefaultItemExcludes>$(DefaultItemExcludes);web/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TouhouChess.Core">
      <HintPath>$(GameData)/Managed/TouhouChess.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
